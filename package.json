{
  "name": "igt",
  "version": "3.7.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0"
  },
  "bin": {
    "igt": "./igt.mjs"
  },
  "scripts": {
    "android:build": "pwsh -NoProfile -File apps/android/build.ps1",
    "mobile:build": "vite build --config apps/mobile/vite.config.ts",
    "mobile:typecheck": "tsc -p apps/mobile/tsconfig.json --noEmit",
    "mobile:dev": "vite --config apps/mobile/vite.config.ts",
    "client:build": "npm run web:build && npm run mobile:build",
    "web:dev": "node scripts/web-dev.mjs",
    "dev:start": "node scripts/web-dev.mjs start",
    "dev:status": "node scripts/web-dev.mjs status",
    "dev:stop": "node scripts/web-dev.mjs stop",
    "dev:restart": "node scripts/web-dev.mjs restart",
    "test:dev-lifecycle": "node --test scripts/dev-runtime/lifecycle.test.mjs scripts/dev-runtime/runtime.test.mjs",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "web:preview": "node scripts/web-dev.mjs start --mode preview",
    "web:start": "node --env-file=.env apps/local/server.mjs",
    "test:web": "node scripts/smoke/web-smoke.mjs",
    "test:static": "node scripts/smoke/static-smoke.mjs",
    "test:contracts": "node scripts/smoke/api-client-smoke.mjs",
    "test:ask-contract": "node scripts/smoke/ask-contract-smoke.mjs",
    "test:runtime": "node scripts/smoke/runtime-api-smoke.mjs",
    "test:coach-cache": "node scripts/smoke/coach-cache-smoke.mjs",
    "test:my-learning": "node --test tests/my-learning.test.mjs tests/grammar-history.test.mjs tests/handbook-cli.test.mjs tests/handbook-delete.test.mjs",
    "test:my-learning-web": "node scripts/smoke/my-learning-web-smoke.mjs",
    "test:mobile-ui": "node scripts/smoke/mobile-ui-audit.mjs",
    "test:mobile-app": "node scripts/smoke/mobile-app-smoke.mjs",
    "test:vocabulary-sync": "node scripts/smoke/vocabulary-sync-smoke.mjs",
    "test:review-log-contract": "node scripts/smoke/review-log-contract-smoke.mjs",
    "test:config-paths": "node scripts/smoke/config-path-smoke.mjs",
    "test:web-dev": "node --test scripts/dev-runtime/lifecycle.test.mjs",
    "test:practice-log": "node scripts/smoke/practice-log-smoke.mjs",
    "test:practice-web": "node scripts/smoke/practice-web-smoke.mjs",
    "test:handbook": "node --test --test-isolation=none tests/handbook-profile.test.mjs tests/handbook-report.test.mjs tests/handbook-browser-data.test.mjs tests/handbook-rules.test.mjs tests/handbook-practice.test.mjs tests/handbook-reports.test.mjs tests/handbook-evidence.test.mjs",
    "test:handbook-web": "node scripts/smoke/handbook-web-smoke.mjs",
    "test:migration-backup": "node scripts/smoke/migration-backup-smoke.mjs",
    "init-db": "node scripts/db/init-db.mjs",
    "index-books": "node scripts/db/index-books.mjs",
    "index-wikipedia": "node scripts/db/index-wikipedia.mjs",
    "verify-learning-resources": "node scripts/verify-learning-resources.mjs",
    "verify:practice-bank": "node scripts/verify-practice-bank.mjs",
    "export:practice-bank": "node scripts/export-practice-bank.mjs --export",
    "test:learning": "node --test --test-isolation=none tests/local-learning-resources.test.mjs tests/handbook-profile.test.mjs tests/learning-diagnosis.test.mjs tests/coach-ai.test.mjs tests/learning-workflows.test.mjs tests/practice-attempts.test.mjs tests/practice-route.test.mjs tests/practice-question-bank.test.mjs tests/practice-client-timeout.test.mjs tests/word-client-timeout.test.mjs tests/translation-route.test.mjs tests/migrations.test.mjs tests/request-guard.test.mjs tests/runtime-lock.test.mjs",
    "ab:run": "node scripts/prompt-ab/run.mjs",
    "ab:list": "node scripts/prompt-ab/run.mjs --list",
    "ab:snapshot": "node scripts/prompt-ab/snapshot-coach.mjs",
    "test:prompt-ab": "node --test tests/prompt-ab.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "openai": "^6.39.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^8.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer": "^25.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true
  }
}
