# ============================================
# IGT Environment Configuration Template
# ============================================
# Copy this file to .env. Add cloud models and their API keys in Web Model Settings
# or open that page from the CLI with /model add.
# ============================================

# Local fallback for tasks without a saved model selection.
IGT_LLM_PROVIDER=ollama
# Optional installed Ollama model ID.
IGT_DEFAULT_MODEL=

# Saved model configurations and selections are written by the app.
# IGT_LLM_PROFILES uses base64 JSON and includes keys.
# Keep these in .env only; encoding is not encryption.
IGT_LLM_PROFILES=
IGT_WEB_DEFAULT_MODEL=
IGT_CLI_MODELS=

# Local Web Runtime (0 = choose an available local port).
# For trusted-LAN access set IGT_SERVER_HOST=0.0.0.0 and a fixed port; there is
# no login, so never expose this port to the internet.
IGT_SERVER_HOST=127.0.0.1
IGT_SERVER_PORT=0
# Optional extra Host/Origin allowlist entries (comma-separated hostnames/IPs).
# Loopback, the machine name, and its interface addresses are always allowed.
#IGT_ALLOWED_HOSTS=
# Development only: API and Vite ports used by npm run web:dev
IGT_DEV_API_PORT=18964
IGT_WEB_PORT=5173
IGT_PREVIEW_PORT=4173

# File paths (managed in .env)
# *_PATH is a directory. *_FILE is a file.
IGT_DB_FILE=igt_data.db
IGT_GRAMMAR_REF_DB_FILE=grammar_ref.db
IGT_LOG_FILE=igt_db_error.log

# Use absolute paths for Markdown files and folders. Configure each location directly.
IGT_VAULT_PATH=                    # Obsidian vault folder (optional)
IGT_REVIEW_FILE=                   # Grammar review log
IGT_VOCABULARY_FILE=               # Vocabulary Markdown file
IGT_PRACTICE_FILE=                 # Practice Markdown log
IGT_ASK_PATH=                      # Folder for individual Ask notes
IGT_REPORT_PATH=                   # General reports folder
IGT_COACH_REPORTS_PATH=            # Coach reports folder (optional override of IGT_REPORT_PATH)

# ============================================================================
#  TEXT-TO-SPEECH  (/chat voice, /review [a]) — OpenAI /v1/audio/speech protocol.
#  Two supported backends; switch by swapping which profile is commented, restart igt:
#
#    • Kokoro — native OpenAI-compatible, preset voices, low latency, no extra parts.
#    • CosyVoice3 — clones a reference voice (cross-lingual). Needs the local shim
#      (tools/cosyvoice-tts-shim.mjs, auto-launched via IGT_TTS_SIDECAR) in front of a
#      CosyVoice Docker container; see tools/cosyvoice/ for the streaming server patch.
# ============================================================================

# --- Kokoro profile ---
IGT_TTS_BASE_URL=http://localhost:8880   # kokoro-engine API (port 3000 is its web UI)
IGT_TTS_SIDECAR=                          # native OpenAI — no adapter needed
IGT_TTS_STREAM=false
IGT_TTS_VOICE=                            # e.g. af_heart (blank = backend default)
IGT_TTS_MODEL=                            # e.g. kokoro

# --- CosyVoice3 profile (comment the Kokoro lines above, uncomment these) ---
# IGT_TTS_BASE_URL=http://localhost:8881  # the shim's port
# IGT_TTS_SIDECAR=tools/cosyvoice-tts-shim.mjs
# IGT_TTS_STREAM=true                      # low-latency ffplay streaming (needs ffmpeg on PATH)
# IGT_TTS_FFPLAY=                          # absolute ffplay.exe path if not on PATH
# COSY_BASE_URL=http://localhost:50000     # CosyVoice container
# COSY_MODE=inference_zero_shot
# COSY_PROMPT_WAV=                         # reference voice clip to clone (absolute path)
# COSY_PROMPT_TEXT=                        # exact transcript of that clip
# COSY_SAMPLE_RATE=24000

# UI
IGT_THEME=auto                     # auto, light, or dark
IGT_TIMEZONE=Asia/Shanghai         # Timezone for date calculations (IANA tz name)

# Tool-calling behavior
IGT_PRE_FETCH_INSTEAD_OF_TOOLS=false # Set to true to bypass native tool calling and use fast pre-fetch injection for cloud models

# Coach report budgets for local Ollama generation.
IGT_COACH_OLLAMA_CONTEXT_TOKENS=16384
IGT_COACH_OLLAMA_OUTPUT_TOKENS=8192
# Cloud report output budget includes reasoning tokens for reasoning models.
IGT_COACH_OUTPUT_TOKENS=32768
# Total time for model loading, report generation and one validation retry (10 minutes).
IGT_COACH_REPORT_TIMEOUT_MS=600000

